# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string (mongodb+srv://...)
MONGO_URL=
DB_NAME=prakritidx

# Gemini API key — used for both the free-hook teaser and the paid AI report
# (including vision on selfies and lab reports). Get one at
# https://aistudio.google.com/apikey (free tier, no credit card needed)
GEMINI_API_KEY=

# Razorpay — use TEST mode keys while developing, switch to LIVE keys at launch.
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: set this up in Razorpay Dashboard > Webhooks, and
# paste the same secret you configure there so signatures can be verified.
RAZORPAY_WEBHOOK_SECRET=

# Public URL of the deployed FRONTEND (used to build the Razorpay callback_url).
# e.g. https://prakritidx.onrender.com
APP_PUBLIC_URL=

# Comma-separated list of allowed frontend origins for CORS, or * for all.
# e.g. https://prakritidx.onrender.com
CORS_ORIGINS=*
